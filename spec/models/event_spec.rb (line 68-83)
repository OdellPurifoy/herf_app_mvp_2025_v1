describe 'after_update' do
  it 'sends notifications to members when an event is updated' do
    event = Event.create!(valid_event_attributes)
    
    # Reset the calls that happened during creation
    allow(EventNotificationService).to receive(:new).and_return(notification_service)
    allow(notification_service).to receive(:notify_members)
    
    # Store original date for message verification
    original_date = event.date.strftime('%m/%d/%Y')
    
    # Update the event
    event.update!(name: 'Updated Event Name')
    
    # Verify message matches the actual format defined in the model
    expect(EventNotificationService).to have_received(:new) do |event_arg, message|
      expect(event_arg).to eq(event)
      expect(message).to include("Updated Event Name has updated the event: Updated Event Name on #{original_date}")
      expect(message).to include("Changes: Name: 'Test Event' → 'Updated Event Name'")
    end
    
    expect(notification_service).to have_received(:notify_members).once
  end
end