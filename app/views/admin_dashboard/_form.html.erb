<%= form_with url: admin_member_upload_path, local: true, multipart: true, data: { turbo: false } do |form| %>
  <div class="space-y-4">
    <%= form.label :members_file, "Members CSV File", class: "block text-sm font-medium text-gray-700" %>
    <%= form.file_field :members_file, 
                        accept: "text/csv,.csv", 
                        required: true,
                        class: "mt-1 py-2 px-3 block w-full border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    <%= form.label :csv_info, class: "mt-1 block text-xs text-gray-500" do %>
      Only CSV files are accepted
    <% end %>
    
    <%= form.label :lounge_id, "Select Lounge", class: "mt-4 block text-sm font-medium text-gray-700" %>
    <%= form.collection_select :lounge_id, 
                              Lounge.all, 
                              :id, 
                              :name, 
                              { prompt: "Select a lounge..." }, 
                              { required: true,
                                class: "mt-1 block w-full py-2 px-3 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" } %>
    
    <%= form.submit "Upload Members", 
                   class: "mt-6 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500",
                   data: { disable_with: "Uploading..." } %>
  </div>
<% end %>
