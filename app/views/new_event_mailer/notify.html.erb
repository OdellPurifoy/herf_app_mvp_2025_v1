<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        padding: 0;
      }
      .container {
        width: 80%;
        margin: auto;
        background-color: #ffffff;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }
      .header {
        text-align: center;
        padding: 10px 0;
      }
      .header h1 {
        color: #333333;
      }
      .content {
        margin: 20px 0;
      }
      .content p {
        color: #666666;
        line-height: 1.6;
      }
      .flyer {
        text-align: center;
        margin: 20px 0;
      }
      .flyer img {
        max-width: 100%;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }
      .footer {
        text-align: center;
        padding: 10px 0;
        color: #999999;
        font-size: 12px;
      }
      .contact {
        margin-top: 20px;
        text-align: center;
      }
      .contact p {
        color: #666666;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Join us, <%= @member.first_name %>!</h1>
      </div>
      <div class="content">
        <p>
          We are thrilled to have you as a part of our community. To kick things off, we are excited to invite you to our upcoming event: <strong><%= @event.name %></strong>.
        </p>
        <p>
          Join us on <%= @event.date.strftime('%A, %B %d, %Y') %> at <%= @event.start_time.strftime('%I:%M %p') %> for an unforgettable experience. This event promises to be filled with fun, excitement, and great company.
        </p>
        <p>
          <strong>Event Description:</strong> <%= @event.description %>
        </p>
        <p>
          Don't miss out on this fantastic opportunity to connect with fellow members and enjoy a memorable time. We look forward to seeing you there!
        </p>
      </div>
      <% if @event.flyer.attached? %>
        <div class="flyer">
          <img src="<%= url_for(@event.flyer) %>" alt="Event Flyer">
        </div>
      <% end %>
      <div class="contact">
        <p>If you have any questions, feel free to contact us at <%= @event.lounge.email %> or call us at <%= format_phone_number(@event.lounge.phone_number) %>.</p>
      </div>
      <div class="footer">
        <p>Thanks for joining and have a great day!</p>
        <p>example.com Team</p>
      </div>
    </div>
  </body>
</html>
