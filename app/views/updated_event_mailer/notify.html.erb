<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        padding: 0;
      }
      .container {
        width: 80%;
        margin: auto;
        background-color: #ffffff;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }
      .header {
        text-align: center;
        padding: 10px 0;
      }
      .header h1 {
        color: #333333;
      }
      .content {
        margin: 20px 0;
      }
      .content p {
        color: #666666;
        line-height: 1.6;
      }
      .highlight {
        color: #ff0000;
      }
      .flyer {
        text-align: center;
        margin: 20px 0;
      }
      .flyer img {
        max-width: 100%;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }
      .footer {
        text-align: center;
        padding: 10px 0;
        color: #999999;
        font-size: 12px;
      }
      .contact {
        margin-top: 20px;
        text-align: center;
      }
      .contact p {
        color: #666666;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Event Update, <%= @member.first_name %>!</h1>
      </div>
      <div class="content">
        <p>
          We wanted to let you know that our upcoming event, <strong><%= @event.name %></strong>, has been updated with new details.
        </p>
        <% if @changed_attributes.include?(:date) %>
          <p class="highlight">
            <strong>New Date:</strong> <%= @event.date.strftime('%A, %B %d, %Y') %>
          </p>
        <% end %>
        <% if @changed_attributes.include?(:start_time) %>
          <p class="highlight">
            <strong>New Start Time:</strong> <%= @event.start_time.strftime('%I:%M %p') %>
          </p>
        <% end %>
        <% if @changed_attributes.include?(:end_time) %>
          <p class="highlight">
            <strong>New End Time:</strong> <%= @event.end_time.strftime('%I:%M %p') %>
          </p>
        <% end %>
        <% if @changed_attributes.include?(:description) %>
          <p class="highlight">
            <strong>Updated Event Description:</strong> <%= @event.description %>
          </p>
        <% end %>
        <p>
          Don't miss out on this fantastic opportunity to connect with fellow members and enjoy a memorable time. We look forward to seeing you there!
        </p>
      </div>
      <% if @event.flyer.attached? %>
        <div class="flyer">
          <img src="<%= url_for(@event.flyer) %>" alt="Event Flyer">
        </div>
      <% end %>
      <div class="contact">
        <p>If you have any questions, feel free to contact us at <%= @event.lounge.email %> or call us at <%= format_phone_number(@event.lounge.phone_number) %>.</p>
      </div>
      <div class="footer">
        <p>Thanks for being a part of our community and have a great day!</p>
        <p>example.com Team</p>
      </div>
    </div>
  </body>
</html>