<div class="bg-white">
  <!-- Hero -->
  <div class="relative isolate overflow-hidden bg-gray-900">
    <img src="<%= asset_path('main_page_cover.jpg') %>" alt="Cigar lounge" class="absolute inset-0 -z-10 size-full object-cover opacity-30">
    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
      <div class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl py-32 sm:py-48 lg:py-56">
        <div class="text-center">
          <h1 class="text-balance text-5xl font-semibold text-white sm:text-7xl">The Cigar Community, Connected</h1>
          <p class="mt-8 text-pretty text-lg font-medium text-gray-300 sm:text-xl/8">
            Discover cigar events and offers near you — or power your lounge with tools to grow your community.
          </p>

          <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
            <%= link_to explore_path, class: "w-full sm:w-auto rounded-md bg-indigo-500 px-8 py-4 text-base font-semibold text-white shadow-sm hover:bg-indigo-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 text-center" do %>
              Find Events & Offers
            <% end %>

            <%= link_to for_lounges_path, class: "w-full sm:w-auto rounded-md bg-white/10 px-8 py-4 text-base font-semibold text-white shadow-sm ring-1 ring-inset ring-white/20 hover:bg-white/20 text-center" do %>
              I Own a Lounge
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]" aria-hidden="true">
      <div class="relative left-[calc(50%+3rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
    </div>
  </div>

  <!-- Value props -->
  <div class="mx-auto max-w-7xl px-6 lg:px-8 py-24 sm:py-32">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <!-- For cigar enthusiasts -->
      <div>
        <h2 class="text-base/7 font-semibold text-indigo-600">For Cigar Enthusiasts</h2>
        <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">Discover what's happening</p>
        <p class="mt-4 text-lg text-gray-600">
          Browse upcoming events, special offers, and lounges in your area. Register for events and never miss a great night out.
        </p>
        <div class="mt-8">
          <%= link_to "Browse Events", explore_path,
              class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
          <span class="ml-1" aria-hidden="true">&rarr;</span>
        </div>
      </div>

      <!-- For lounge owners -->
      <div>
        <h2 class="text-base/7 font-semibold text-indigo-600">For Lounge Owners</h2>
        <p class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">Grow your community</p>
        <p class="mt-4 text-lg text-gray-600">
          Manage events, members, and special offers from one dashboard. Notify your members automatically and attract new customers through our public directory.
        </p>
        <div class="mt-8">
          <%= link_to "Learn More", for_lounges_path,
              class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
          <span class="ml-1" aria-hidden="true">&rarr;</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-gray-900">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-24 lg:px-8 lg:py-32">
      <div class="xl:grid xl:grid-cols-3 xl:gap-8">
        <p class="text-xl font-semibold text-white">HERF</p>
        <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
          <div class="md:grid md:grid-cols-2 md:gap-8">
            <div>
              <h3 class="text-sm/6 font-semibold text-white">Explore</h3>
              <ul role="list" class="mt-6 space-y-4">
                <li>
                  <%= link_to "Events & Offers", explore_path, class: "text-sm/6 text-gray-400 hover:text-white" %>
                </li>
                <li>
                  <%= link_to "For Lounge Owners", for_lounges_path, class: "text-sm/6 text-gray-400 hover:text-white" %>
                </li>
              </ul>
            </div>
            <div class="mt-10 md:mt-0">
              <h3 class="text-sm/6 font-semibold text-white">Legal</h3>
              <ul role="list" class="mt-6 space-y-4">
                <li>
                  <a href="#" class="text-sm/6 text-gray-400 hover:text-white">Terms of service</a>
                </li>
                <li>
                  <a href="#" class="text-sm/6 text-gray-400 hover:text-white">Privacy policy</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </footer>
</div>
