<div class="max-w-2xl mx-auto px-6 lg:px-8 py-10">
  <!-- Breadcrumb -->
  <nav class="mb-6">
    <%= link_to explore_event_path(@event), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" do %>
      <span aria-hidden="true">&larr;</span> Back to Event
    <% end %>
  </nav>

  <div class="bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/10 overflow-hidden">
    <div class="p-6 sm:p-8">
      <!-- Event Summary -->
      <div class="mb-8 pb-6 border-b border-gray-200">
        <span class="inline-block px-2.5 py-0.5 text-xs font-medium bg-indigo-50 text-indigo-700 rounded-full mb-3">
          <%= @event.event_type %>
        </span>
        <h1 class="text-2xl font-semibold tracking-tight text-gray-900 mb-2"><%= @event.name %></h1>
        <p class="text-gray-600">
          <%= @event.date.strftime("%A, %B %-d, %Y") %>
          &middot;
          <%= @event.start_time.strftime("%-I:%M %p") %> - <%= @event.end_time.strftime("%-I:%M %p") %>
        </p>
        <p class="text-sm text-gray-500 mt-1">
          Hosted by <%= @lounge.name %> &middot; <%= @lounge.city %>, <%= @lounge.state %>
        </p>

        <% if @spots_remaining.present? %>
          <p class="mt-3 text-sm">
            <% if @spots_remaining > 0 %>
              <span class="font-semibold text-indigo-600"><%= @spots_remaining %></span>
              <span class="text-gray-600">spots remaining</span>
            <% else %>
              <span class="font-semibold text-red-600">This event is at full capacity</span>
            <% end %>
          </p>
        <% end %>
      </div>

      <!-- Registration Form -->
      <h2 class="text-lg font-semibold text-gray-900 mb-6">Register for this event</h2>

      <% if @spots_remaining.present? && @spots_remaining <= 0 %>
        <div class="bg-red-50 ring-1 ring-red-200 rounded-xl p-6 text-center">
          <p class="text-red-700 font-medium">Sorry, this event is at full capacity.</p>
          <p class="text-red-600 text-sm mt-1">Check back later in case spots open up.</p>
        </div>
      <% else %>
        <%= form_with(model: @registration, url: event_registrations_path(@event), class: "space-y-5") do |f| %>
          <% if @registration.errors.any? %>
            <div class="bg-red-50 ring-1 ring-red-200 rounded-xl p-4">
              <div class="flex">
                <svg class="h-5 w-5 text-red-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                </svg>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800">Please fix the following:</h3>
                  <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                    <% @registration.errors.full_messages.each do |msg| %>
                      <li><%= msg %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          <% end %>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <%= f.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.text_field :first_name, required: true,
                  class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
                  placeholder: "First name" %>
            </div>

            <div>
              <%= f.label :last_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.text_field :last_name, required: true,
                  class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
                  placeholder: "Last name" %>
            </div>
          </div>

          <div>
            <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.email_field :email, required: true,
                class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
                placeholder: "you@example.com" %>
          </div>

          <div>
            <%= f.label :phone_number, "Phone number (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.telephone_field :phone_number,
                class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
                placeholder: "(555) 123-4567" %>
          </div>

          <div>
            <%= f.label :number_of_guests, "Additional guests", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.number_field :number_of_guests, min: 0, max: 10, value: @registration.number_of_guests || 0,
                class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            <p class="mt-1 text-xs text-gray-500">Number of additional guests you're bringing (0 if attending alone)</p>
          </div>

          <div class="relative flex items-start pt-2">
            <div class="flex h-6 items-center">
              <%= f.check_box :opt_in_to_membership,
                  class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
            </div>
            <div class="ml-3">
              <%= f.label :opt_in_to_membership, class: "text-sm text-gray-700" do %>
                I'm interested in becoming a member at <span class="font-medium"><%= @lounge.name %></span>
              <% end %>
              <p class="text-xs text-gray-500 mt-0.5">The lounge will reach out to you with membership details, pricing, and availability.</p>
            </div>
          </div>

          <div class="pt-4">
            <%= f.submit "Register",
                class: "w-full rounded-md bg-indigo-500 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 cursor-pointer" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
