<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      /* Email styles need to be inline */
    </style>
  </head>

  <body>
    <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
      <div style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%); color: white; padding: 30px; text-align: center;">
        <h1 style="margin: 0; font-size: 28px;">🚫 Membership Cancelled</h1>
        <p style="margin: 10px 0 0 0; font-size: 16px; opacity: 0.9;"><%= @membership.lounge.name %></p>
      </div>
      
      <div style="padding: 30px; background-color: #f8f9fa;">
        <h2 style="color: #333; margin-bottom: 20px;">Dear <%= @membership.first_name %> <%= @membership.last_name %>,</h2>
        
        <p style="color: #555; line-height: 1.6; margin-bottom: 20px;">
          We regret to inform you that your membership with <%= @membership.lounge.name %> has been cancelled.
        </p>
        
        <div style="background: white; padding: 25px; border-radius: 8px; border-left: 4px solid #e74c3c; margin-bottom: 25px;">
          <h3 style="color: #333; margin-top: 0; margin-bottom: 15px;">Membership Details</h3>
          <p style="color: #666; margin-bottom: 10px;"><strong>👤 Name:</strong> <%= @membership.first_name %> <%= @membership.last_name %></p>
          <p style="color: #666; margin-bottom: 10px;"><strong>📧 Email:</strong> <%= @membership.email.presence || 'Not provided' %></p>
          <p style="color: #666; margin-bottom: 10px;"><strong>📱 Phone Number:</strong> <%= @membership.phone_number.presence || 'Not provided' %></p>
        </div>
        
        <div style="background: #fef2f2; padding: 20px; border-radius: 8px; margin-bottom: 25px;">
          <h4 style="color: #b91c1c; margin-top: 0;">Cancellation Notice</h4>
          <p style="color: #666; line-height: 1.6;">
            If you believe this cancellation was made in error or if you have any questions, 
            please do not hesitate to contact us using the information below.
          </p>
        </div>
        
        <p style="color: #555; line-height: 1.6;">
          If you have any questions, feel free to contact us at <%= @membership.lounge.email %> or call us at <%= format_phone_number(@membership.lounge.phone_number) %>.
        </p>
      </div>
      
      <div style="background-color: #333; color: #ccc; padding: 20px; text-align: center; font-size: 12px;">
        <p style="margin: 0;">Thank you for your time with us.</p>
        <p style="margin: 5px 0 0 0;"><%= @membership.lounge.name %> Team</p>
        <p style="margin: 5px 0 0 0;">Powered by Herf</p>
      </div>
    </div>
  </body>
</html>