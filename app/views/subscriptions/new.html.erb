<div class="bg-white">
  <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8 lg:py-40">
    <div class="mx-auto max-w-4xl">
      <div class="rounded-3xl bg-gray-50 p-8 ring-1 ring-gray-900/10 sm:p-10">
        <h2 class="text-2xl font-semibold leading-10 tracking-tight text-gray-900">Subscribe to <%= @plan[:name] %> Plan</h2>
        <p class="mt-4 text-base leading-7 text-gray-600">You are about to subscribe to our <%= @plan[:name] %> plan at $<%= @plan[:amount] / 100 %> per <%= @plan[:interval] %>.</p>
        
        <div class="mt-8">
          <h3 class="text-base font-semibold leading-6 text-gray-900">What's included:</h3>
          <ul role="list" class="mt-4 space-y-3">
            <% @plan[:features].each do |feature| %>
              <li class="flex gap-x-3">
                <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm leading-6 text-gray-600"><%= feature %></span>
              </li>
            <% end %>
          </ul>
        </div>
        
        <div class="mt-10 flex items-center gap-x-4">
          <%= form_tag subscription_path(plan: params[:plan]), method: :post, data: { turbo: false } do %>
            <button type="submit" class="rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Subscribe Now</button>
          <% end %>
          <%= link_to "Cancel", root_path, class: "text-sm font-semibold leading-6 text-gray-900" %>
        </div>
      </div>
    </div>
  </div>
</div>
