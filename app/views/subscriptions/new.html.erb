<nav class="bg-gray-800">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 justify-between">
      <div class="flex">
        <div class="-ml-2 mr-2 flex items-center md:hidden">
          <!-- Mobile menu button -->
          <button type="button" class="relative inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:bg-gray-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white" aria-controls="mobile-menu" aria-expanded="false">
            <span class="absolute -inset-0.5"></span>
            <span class="sr-only">Open main menu</span>
            <!-- Icon when menu is closed. -->
            <svg class="block size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
            <!-- Icon when menu is open. -->
            <svg class="hidden size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="flex shrink-0 items-center">
          <p class="text-2xl text-bold text-white">Herf</p>
        </div>
        <div class="hidden md:ml-6 md:flex md:items-center md:space-x-4">
          <%= link_to 'Dashboard', dashboard_path, class: "rounded-md bg-gray-900 px-3 py-2 text-sm font-medium text-white" %>
        </div>
      </div>
      <div class="flex items-center">
        <div class="hidden md:ml-4 md:flex md:shrink-0 md:items-center">
          <% if lounge_owner_signed_in? %>
            <%= button_to destroy_lounge_owner_session_path, method: :delete, class: "relative inline-flex items-center gap-x-1.5 rounded-md bg-gray-800 px-3 py-2 text-sm font-semibold text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800", data: { confirm: "Are you sure?" } do %>
              <span class="sr-only">Log out</span>
              Log out
            <% end %>
          <% else %>
            <%= link_to 'Log in', new_lounge_owner_session_path, class: "relative inline-flex items-center gap-x-1.5 rounded-md bg-gray-800 px-3 py-2 text-sm font-semibold text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</nav>

<div class="bg-white">
  <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8 lg:py-40">
    <div class="mx-auto max-w-4xl">
      <div class="rounded-3xl bg-gray-50 p-8 ring-1 ring-gray-900/10 sm:p-10">
        <h2 class="text-2xl font-semibold leading-10 tracking-tight text-gray-900">Subscribe to <%= @plan[:name] %> Plan</h2>
        <p class="mt-4 text-base leading-7 text-gray-600">You are about to subscribe to our <%= @plan[:name] %> plan at $<%= @plan[:amount] / 100 %> per <%= @plan[:interval] %>.</p>
        
        <div class="mt-8">
          <h3 class="text-base font-semibold leading-6 text-gray-900">What's included:</h3>
          <ul role="list" class="mt-4 space-y-3">
            <% @plan[:features].each do |feature| %>
              <li class="flex gap-x-3">
                <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm leading-6 text-gray-600"><%= feature %></span>
              </li>
            <% end %>
          </ul>
        </div>
        
        <div class="mt-10 flex items-center gap-x-4">
          <%= form_tag subscription_path(plan: params[:plan]), method: :post, data: { turbo: false } do %>
            <button type="submit" class="rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Subscribe Now</button>
          <% end %>
          <%= link_to "Cancel", root_path, class: "text-sm font-semibold leading-6 text-gray-900" %>
        </div>
      </div>
    </div>
  </div>
</div>
