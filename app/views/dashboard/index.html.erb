                    <div class="inline-flex justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300">
                      <svg class="-ml-0.5 mr-1.5 size-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                        <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" clip-rule="evenodd" />
                      </svg>
                      <span><%= @lounge&.phone_number.presence || '123-456-7890' %></span>
                    </div>
                    <div class="inline-flex justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300">
                      <svg class="-ml-0.5 mr-1.5 size-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                        <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h13A1.5 1.5 0 0 1 18 3.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 2 16.5v-13ZM3.5 4a.5.5 0 0 0-.5.5v11a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-11a.5.5 0 0 0-.5-.5h-13ZM4 5h12v1H4V5Zm0 2h12v1H4V7Zm0 2h12v1H4V9Zm0 2h12v1H4v-1Zm0 2h12v1H4v-1Zm0 2h12v1H4v-1Z" />
                      </svg>
                      <span><%= @lounge&.email.presence || 'your_lounge_email@example.com' %></span>
                    </div>
                  </div>
              </div>
            </div>
            <div class="mt-6 hidden min-w-0 flex-1 sm:block md:hidden">
              <h1 class="truncate text-2xl font-bold text-gray-900"><%= @lounge&.name %></h1>
            </div>
          </div>
        </div>

        <% if @lounge %>
          <div class="border-b border-gray-200 pb-5 pt-12 sm:flex sm:items-center sm:justify-between">
            <h3 class="text-base font-semibold text-gray-900">Upcoming Event</h3>
            <div class="mt-3 sm:ml-4 sm:mt-0">
              <%= link_to 'Create new event', new_lounge_event_path(@lounge), class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
            </div>
          </div>
        <% end %>

        <% if @upcoming_events && @upcoming_events.any? %>
          <div class="mt-6 overflow-hidden rounded-lg bg-gray-100">
            <div class="px-4 py-5 sm:p-6">
              <h4 class="text-lg font-semibold text-gray-900"><%= @upcoming_events.first.name %></h4>
              <p class="mt-2 text-sm text-gray-600"><%= @upcoming_events.first.description %></p>
              <p class="mt-2 text-sm text-gray-600"><strong>Date:</strong> <%= @upcoming_events.first.date.strftime("%B %d, %Y") %></p>
              <p class="mt-2 text-sm text-gray-600"><strong>Time:</strong> <%= @upcoming_events.first.start_time.strftime("%I:%M %p") %> - <%= @upcoming_events.first.end_time.strftime("%I:%M %p") %></p>
              <p class="mt-2 text-sm text-gray-600"><strong>Type:</strong> <%= @upcoming_events.first.event_type %></p>
              <p class="mt-2 text-sm text-gray-600"><strong>Location:</strong> <%= @lounge&.address_street_1 %>, <%= @lounge.city %>, <%= @lounge.state %> <%= @lounge.zip_code %></p>
              <div class="mt-4 text-right">
                <%= link_to 'Edit', edit_event_path(@upcoming_events.first), class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
              </div>
            </div>
          </div>
        <% else %>
          <div class="mt-6 overflow-hidden rounded-lg bg-gray-100">
            <div class="px-4 py-5 sm:p-6">
              <p class="mt-6 text-sm text-gray-600 font-semibold">No upcoming events.</p>
            </div>
          </div>
        <% end %>

        <% if @lounge %>
          <div class="border-b border-gray-200 pb-5 pt-12 sm:flex sm:items-center sm:justify-between">
            <h3 class="text-base font-semibold text-gray-900">Upcoming Special Offer</h3>
            <div class="mt-3 sm:ml-4 sm:mt-0">
              <%= link_to 'Create new special offer', new_lounge_special_offer_path(@lounge), class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
            </div>
          </div>
        <% end %>

        <% if @upcoming_special_offers && @upcoming_special_offers.any? %>
          <div class="mt-6 overflow-hidden rounded-lg bg-gray-100">
            <div class="px-4 py-5 sm:p-6 flex">
              <% if @upcoming_special_offers.first.flyer.attached? %>
                <div class="flex-shrink-0 mr-4">
                  <%= image_tag @upcoming_special_offers.first.flyer, class: "h-24 w-24 object-cover rounded-lg" %>
                </div>
              <% end %>
              <div class="flex flex-col justify-between w-full">
                <div>
                  <h4 class="text-lg font-semibold text-gray-900"><%= @upcoming_special_offers.first.name %></h4>
                  <p class="mt-2 text-sm text-gray-600"><%= @upcoming_special_offers.first.description %></p>
                  <p class="mt-2 text-sm text-gray-600"><strong>Start Date:</strong> <%= @upcoming_special_offers.first.start_date.strftime("%B %d, %Y") %></p>
                  <p class="mt-2 text-sm text-gray-600"><strong>End Date:</strong> <%= @upcoming_special_offers.first.end_date.strftime("%B %d, %Y") %></p>
                  <p class="mt-2 text-sm text-gray-600"><strong>Members only:</strong> <%= @upcoming_special_offers.first.members_only? ? 'Yes' : 'No' %></p>
                  <p class="mt-2 text-sm text-gray-600"><strong>Offer Code:</strong> <%= @upcoming_special_offers.first.offer_code.presence || 'None' %></p>
                </div>
                <div class="mt-4 text-right">
                  <%= link_to 'Edit', edit_special_offer_path(@upcoming_special_offers.first), class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
                </div>
              </div>
            </div>
          </div>
        <% else %>
          <div class="mt-6 overflow-hidden rounded-lg bg-gray-100">
            <div class="px-4 py-5 sm:p-6">
              <p class="mt-6 text-sm text-gray-600 font-semibold">No upcoming special offers.</p>
            </div>
          </div>
        <% end %>

      <!-- Your content -->
    </div>
  </main>
</div>
