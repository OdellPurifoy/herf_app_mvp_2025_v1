                </div>
                <div class="mt-6 flex flex-col justify-stretch space-y-3 sm:flex-row sm:space-x-4 sm:space-y-0 sm:justify-end">
                  <div class="text-sm font-semibold text-gray-900 border-b border-gray-300 pb-1">
                    <%= @lounge&.address_street_1.presence || '123 Fake Street' %>, 
                    <%= @lounge&.city.presence || 'Faketown' %>, 
                    <%= @lounge&.state.presence || 'FS' %> 
                    <%= @lounge&.zip_code.presence || '12345' %>
                  </div>
                  <div class="text-sm font-semibold text-gray-900 border-b border-gray-300 pb-1">
                    <%= @lounge&.phone_number.presence || '123-456-7890' %>
                  </div>
                  <div class="text-sm font-semibold text-gray-900 border-b border-gray-300 pb-1">
                    <%= @lounge&.email.presence || 'your_lounge_email@example.com' %>
                  </div>
                </div>
              </div>
            </div>
            <div class="mt-6 hidden min-w-0 flex-1 sm:block md:hidden">
              <h1 class="truncate text-2xl font-bold text-gray-900"><%= @lounge&.name %></h1>
            </div>
          </div>

        <% if @lounge %>
          <div class="border-b border-gray-200 pb-5 pt-12 sm:flex sm:items-center sm:justify-between">
            <h3 class="text-base font-semibold text-gray-900">Upcoming Event</h3>
            <div class="mt-3 sm:ml-4 sm:mt-0">
              <%= link_to new_lounge_event_path(@lounge), class: "inline-flex items-center rounded-md bg-indigo-600 p-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @upcoming_events && @upcoming_events.any? %>
          <div class="mt-6 overflow-hidden rounded-lg bg-gray-100">
            <div class="px-4 py-5 sm:p-6">
              <h4 class="text-lg font-semibold text-gray-900"><%= @upcoming_events.first.name %></h4>
              <p class="mt-2 text-sm text-gray-600"><%= @upcoming_events.first.description %></p>
              <p class="mt-2 text-sm text-gray-600"><strong>Date:</strong> <%= @upcoming_events.first.date.strftime("%B %d, %Y") %></p>
              <p class="mt-2 text-sm text-gray-600"><strong>Time:</strong> <%= @upcoming_events.first.start_time.strftime("%I:%M %p") %> - <%= @upcoming_events.first.end_time.strftime("%I:%M %p") %></p>
              <p class="mt-2 text-sm text-gray-600"><strong>Type:</strong> <%= @upcoming_events.first.event_type %></p>
              <p class="mt-2 text-sm text-gray-600"><strong>Location:</strong> <%= @lounge&.address_street_1 %>, <%= @lounge.city %>, <%= @lounge.state %> <%= @lounge.zip_code %></p>
              
              <% if @upcoming_events.first.rsvp_needed? %>
                <% rsvp_summary = @upcoming_events.first.rsvp_summary %>
                <div class="mt-4 p-4 bg-white rounded-lg border border-gray-200">
                  <h5 class="text-sm font-semibold text-gray-900 mb-3">RSVP Status</h5>
                  <div class="grid grid-cols-2 gap-4 text-sm">
                    <div class="text-center">
                      <div class="text-2xl font-bold text-green-600"><%= rsvp_summary[:attending] %></div>
                      <div class="text-gray-600">Attending</div>
                      <% if rsvp_summary[:total_guests] > rsvp_summary[:attending] %>
                        <div class="text-xs text-gray-500">(<%= rsvp_summary[:total_guests] %> total guests)</div>
                      <% end %>
                    </div>
                    <div class="text-center">
                      <div class="text-2xl font-bold text-yellow-600"><%= rsvp_summary[:pending] %></div>
                      <div class="text-gray-600">Pending</div>
                    </div>
                    <div class="text-center">
                      <div class="text-2xl font-bold text-red-600"><%= rsvp_summary[:declined] %></div>
                      <div class="text-gray-600">Declined</div>
                    </div>
                    <div class="text-center">
                      <div class="text-2xl font-bold text-blue-600"><%= number_to_percentage(@upcoming_events.first.rsvp_response_rate, precision: 1) %></div>
                      <div class="text-gray-600">Response Rate</div>
                    </div>
                  </div>
                  <% if @upcoming_events.first.capacity.present? %>
                    <div class="mt-3 pt-3 border-t border-gray-200">
                      <div class="flex justify-between text-sm">
                        <span class="text-gray-600">Capacity:</span>
                        <span class="font-semibold">
                          <%= rsvp_summary[:total_guests] %> / <%= @upcoming_events.first.capacity %>
                          <% if rsvp_summary[:capacity_remaining] %>
                            (<%= rsvp_summary[:capacity_remaining] %> remaining)
                          <% else %>
                            (At Capacity!)
                          <% end %>
                        </span>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
              
              <div class="mt-4 flex justify-between items-center">
                <% if @upcoming_events.first.rsvp_needed? %>
                  <%= link_to 'View RSVPs', event_rsvps_path(@upcoming_events.first), class: "inline-flex items-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-gray-100 shadow-sm hover:bg-green-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600" %>
                <% end %>
                <div class="space-x-2">
          <%= link_to 'Edit', edit_event_path(@upcoming_events.first), class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
                </div>
              </div>
            </div>
          </div>
        <% else %>
          <div class="mt-6 overflow-hidden rounded-lg bg-gray-100">
            <div class="px-4 py-5 sm:p-6">
              <p class="mt-2 text-sm text-gray-600 font-semibold">No upcoming events.</p>
            </div>
          </div>
        <% end %>

        <% if @lounge %>
          <div class="border-b border-gray-200 pb-5 pt-12 sm:flex sm:items-center sm:justify-between">
            <h3 class="text-base font-semibold text-gray-900">Upcoming Special Offer</h3>
            <div class="mt-3 sm:ml-4 sm:mt-0">
              <%= link_to new_lounge_special_offer_path(@lounge), class: "inline-flex items-center rounded-md bg-indigo-600 p-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @upcoming_special_offers && @upcoming_special_offers.any? %>
          <div class="mt-6 overflow-hidden rounded-lg bg-gray-100">
            <div class="px-4 py-5 sm:p-6 flex">
              <% if @upcoming_special_offers.first.flyer.attached? %>
                <div class="flex-shrink-0 mr-4">
                  <%= image_tag @upcoming_special_offers.first.flyer, class: "h-24 w-24 object-cover rounded-lg" %>
                </div>
              <% end %>
              <div class="flex flex-col justify-between w-full">
                <div>
                  <h4 class="text-lg font-semibold text-gray-900"><%= @upcoming_special_offers.first.name %></h4>
                  <p class="mt-2 text-sm text-gray-600"><%= @upcoming_special_offers.first.description %></p>
                  <p class="mt-2 text-sm text-gray-600"><strong>Start Date:</strong> <%= @upcoming_special_offers.first.start_date.strftime("%B %d, %Y") %></p>
                  <p class="mt-2 text-sm text-gray-600"><strong>End Date:</strong> <%= @upcoming_special_offers.first.end_date.strftime("%B %d, %Y") %></p>
                  <p class="mt-2 text-sm text-gray-600"><strong>Members only:</strong> <%= @upcoming_special_offers.first.members_only? ? 'Yes' : 'No' %></p>
                  <p class="mt-2 text-sm text-gray-600"><strong>Offer Code:</strong> <%= @upcoming_special_offers.first.offer_code.presence || 'None' %></p>
                </div>
                <div class="mt-4 text-right">
                  <%= link_to 'Edit', edit_special_offer_path(@upcoming_special_offers.first), class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
                </div>
              </div>
            </div>
          </div>
        <% else %>
          <div class="mt-6 overflow-hidden rounded-lg bg-gray-100">
            <div class="px-4 py-5 sm:p-6">
              <p class="mt-2 text-sm text-gray-600 font-semibold">No upcoming special offers.</p>
            </div>
          </div>
        <% end %>

      <!-- Right column -->
      <div class="grid grid-cols-1 gap-4">
        <!-- Subscription status -->
        <section aria-labelledby="subscription-status" class="overflow-hidden rounded-lg bg-white shadow">
          <div class="p-6">
            <div class="flex items-center">
              <h2 id="subscription-status" class="text-base font-medium text-gray-900">Subscription Status</h2>
              <div class="ml-4 flex items-center">
                <% if @has_active_subscription %>
                  <div class="flex h-6 w-6 items-center justify-center rounded-full bg-green-100">
                    <svg class="h-4 w-4 text-green-600" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <span class="ml-2 text-sm font-medium text-green-700">Active</span>
                <% else %>
                  <div class="flex h-6 w-6 items-center justify-center rounded-full bg-red-100">
                    <svg class="h-4 w-4 text-red-600" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
                    </svg>
                  </div>
                  <span class="ml-2 text-sm font-medium text-red-700">Inactive</span>
                <% end %>
              </div>
            </div>
            
            <div class="mt-6">
              <% if @has_active_subscription %>
                <p class="text-sm text-gray-500">Your subscription is active. You can manage your subscription through our billing portal.</p>
                <%= link_to "Manage Billing", billing_portal_subscription_path, class: "mt-4 block w-full rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
              <% else %>
                <p class="text-sm text-gray-500">You don't have an active subscription. Subscribe to create a lounge and start managing your cigar lounge business.</p>
                <%= link_to "Choose a Plan", root_path(anchor: "pricing"), class: "mt-4 block w-full rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
              <% end %>
            </div>
          </div>
        </section>
        
        <!-- ... existing content ... -->
      </div>

      <!-- Your content -->
    </div>
  </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const openMobileSidebarButton = document.getElementById('open-mobile-sidebar');
  const closeMobileSidebarButton = document.getElementById('close-mobile-sidebar');
  const mobileSidebar = document.getElementById('mobile-sidebar');

  // Open mobile sidebar
  if (openMobileSidebarButton) {
    openMobileSidebarButton.addEventListener('click', function() {
      mobileSidebar.classList.remove('hidden');
    });
  }

  // Close mobile sidebar
  if (closeMobileSidebarButton) {
    closeMobileSidebarButton.addEventListener('click', function() {
      mobileSidebar.classList.add('hidden');
    });
  }

  // Close mobile sidebar when clicking on backdrop
  if (mobileSidebar) {
    mobileSidebar.addEventListener('click', function(e) {
      if (e.target === mobileSidebar || e.target.classList.contains('bg-gray-900/80')) {
        mobileSidebar.classList.add('hidden');
      }
    });
  }
});
</script>
