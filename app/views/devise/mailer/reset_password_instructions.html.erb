<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; text-align: center;">
    <h1 style="margin: 0; font-size: 28px;">🔐 Password Reset</h1>
    <p style="margin: 10px 0 0 0; font-size: 16px; opacity: 0.9;">HERF</p>
  </div>
  
  <div style="padding: 30px; background-color: #f8f9fa;">
    <h2 style="color: #333; margin-bottom: 20px;">Hello!</h2>
    
    <p style="color: #555; line-height: 1.6; margin-bottom: 20px;">
      Someone has requested a link to change your password for your HERF account (<strong><%= @resource.email %></strong>).
    </p>
    
    <p style="color: #555; line-height: 1.6; margin-bottom: 25px;">
      You can reset your password by clicking the button below:
    </p>
    
    <div style="text-align: center; margin-bottom: 25px;">
      <%= link_to 'Reset My Password', edit_password_url(@resource, reset_password_token: @token), style: "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; text-decoration: none; padding: 15px 30px; border-radius: 5px; font-weight: bold; display: inline-block; font-size: 16px;" %>
    </div>
    
    <div style="background: #fff3cd; border: 1px solid #ffeaa7; border-radius: 8px; padding: 20px; margin-bottom: 25px;">
      <p style="color: #856404; margin: 0; font-size: 14px; line-height: 1.5;">
        <strong>⚠️ Important:</strong> If you didn't request this password reset, please ignore this email. Your password won't change until you access the link above and create a new one.
      </p>
    </div>
    
    <hr style="border: none; border-top: 1px solid #eee; margin: 25px 0;">
    
    <p style="color: #888; font-size: 12px; text-align: center; margin: 0;">
      Can't click the button? Copy and paste this link into your browser:<br>
      <span style="word-break: break-all; color: #667eea;"><%= edit_password_url(@resource, reset_password_token: @token) %></span>
    </p>
  </div>
  
  <div style="background-color: #333; color: #ccc; padding: 20px; text-align: center; font-size: 12px;">
    <p style="margin: 0;">This email was sent by HERF</p>
    <p style="margin: 5px 0 0 0;">Powered by Herf</p>
  </div>
</div>
