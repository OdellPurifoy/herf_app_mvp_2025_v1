<div class="mx-auto max-w-7xl sm:px-6 lg:px-8 py-6 sm:py-6 lg:py-8">
  <h1 class="text-2xl font-semibold text-gray-900">Edit Event</h1>

  <div class="mt-5">
    <%= render 'form', lounge: @lounge, event: @event %>
  </div>

  <div class="mt-5">
    <%= link_to 'Back', dashboard_path, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
  </div>

  <div class="mt-5">
    <%= link_to 'Delete Event', @event, method: :delete, data: { confirm: 'Are you sure you want to delete this event?' }, class: "text-sm font-semibold text-red-600 hover:text-red-500" %>
  </div>
</div>