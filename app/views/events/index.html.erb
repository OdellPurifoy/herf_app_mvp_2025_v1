<div class="mx-auto max-w-7xl sm:px-6 lg:px-8 py-6 sm:py-6 lg:py-8">
  <h1 class="text-2xl font-semibold text-gray-900">All Events</h1>

  <ul role="list" class="divide-y divide-gray-300 mt-6">
    <% @events.each do |event| %>
      <li class="flex flex-col gap-y-4 py-5">
        <div class="flex justify-between gap-x-6">
          <div class="flex min-w-0 gap-x-4">
            <% if event.flyer.attached? %>
              <%= image_tag event.flyer, class: "size-12 flex-none rounded-full bg-gray-50" %>
            <% else %>
              <div class="size-12 flex-none rounded-full bg-gray-200"></div>
            <% end %>
            <div class="min-w-0 flex-auto">
              <p class="text-sm/6 font-semibold text-gray-900"><%= event.name %></p>
              <p class="mt-1 text-xs/5 text-gray-500"><%= event.description %></p>
            </div>
          </div>
          <div class="hidden shrink-0 sm:flex sm:flex-col sm:items-end">
            <p class="text-sm/6 text-gray-900"><%= event.event_type %></p>
            <p class="mt-1 text-xs/5 text-gray-500"><%= event.date.strftime("%B %d, %Y") %> <%= event.start_time.strftime("%I:%M %p") %> - <%= event.end_time.strftime("%I:%M %p") %></p>
          </div>
        </div>
        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs/5 text-gray-500">
          <span><strong>Virtual:</strong> <%= event.virtual ? 'Yes' : 'No' %></span>
          <span><strong>Members Only:</strong> <%= event.members_only ? 'Yes' : 'No' %></span>
          <span><strong>RSVP Needed:</strong> <%= event.rsvp_needed ? 'Yes' : 'No' %></span>
          <span><strong>Entry Fee:</strong> <%= event.entry_fee.present? ? event.entry_fee : 'Free' %></span>
          <span><strong>Capacity:</strong> <%= event.capacity.present? ? event.capacity : 'Unlimited' %></span>
        </div>
        <div class="mt-4 text-right">
          <%= link_to 'Edit Event', edit_event_path(event), class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
        </div>
      </li>
    <% end %>
  </ul>
</div>