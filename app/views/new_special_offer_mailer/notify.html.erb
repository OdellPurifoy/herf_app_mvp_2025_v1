<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      /* Email styles need to be inline */
    </style>
  </head>

  <body>
    <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
      <div style="background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%); color: white; padding: 30px; text-align: center;">
        <h1 style="margin: 0; font-size: 28px;">🎉 Special Offer Announced</h1>
        <p style="margin: 10px 0 0 0; font-size: 16px; opacity: 0.9;"><%= @special_offer.lounge.name %></p>
      </div>
      
      <div style="padding: 30px; background-color: #f8f9fa;">
        <h2 style="color: #333; margin-bottom: 20px;">Exclusive Offer For You, <%= @member.first_name %>!</h2>
        
        <p style="color: #555; line-height: 1.6; margin-bottom: 20px;">
          We are excited to bring you an exclusive special offer: <strong><%= @special_offer.name %></strong>
        </p>
        
        <div style="background: white; padding: 25px; border-radius: 8px; border-left: 4px solid #2ecc71; margin-bottom: 25px;">
          <h3 style="color: #333; margin-top: 0; margin-bottom: 15px;">Offer Details</h3>
          <p style="color: #666; margin-bottom: 10px;"><strong>🏷️ Offer Type:</strong> <%= @special_offer.offer_type %></p>
          <p style="color: #666; margin-bottom: 10px;"><strong>📅 Start Date:</strong> <%= @special_offer.start_date.strftime('%A, %B %d, %Y') %></p>
          <p style="color: #666; margin-bottom: 10px;"><strong>📅 End Date:</strong> <%= @special_offer.end_date.strftime('%A, %B %d, %Y') %></p>
          <p style="color: #666; margin-bottom: 10px;"><strong>🔒 Members Only:</strong> <%= @special_offer.members_only ? 'Yes' : 'No' %></p>
          <% if @special_offer.offer_code.present? %>
            <p style="color: #666; margin-bottom: 10px;"><strong>🎟️ Offer Code:</strong> <span style="background: #f0f9f4; padding: 3px 8px; border-radius: 4px; font-family: monospace; font-weight: bold;"><%= @special_offer.offer_code %></span></p>
          <% end %>
        </div>
        
        <div style="background: #f0f9f4; padding: 20px; border-radius: 8px; margin-bottom: 25px;">
          <h4 style="color: #166534; margin-top: 0;">Description</h4>
          <p style="color: #666; line-height: 1.6;">
            <%= @special_offer.description %>
          </p>
        </div>
        
        <% if @special_offer.flyer.attached? %>
          <div style="text-align: center; margin: 30px 0;">
            <img src="<%= url_for(@special_offer.flyer) %>" alt="Special Offer Flyer" style="max-width: 100%; border-radius: 8px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
          </div>
        <% end %>
        
        <p style="color: #555; line-height: 1.6;">
          Don't miss out on this amazing opportunity! Visit us at <%= @special_offer.lounge.name %> located at <%= @special_offer.lounge.address_street_1 %>, <%= @special_offer.lounge.city %>, <%= @special_offer.lounge.state %>.
        </p>
        
        <p style="color: #555; line-height: 1.6;">
          If you have any questions, feel free to contact us at <%= @special_offer.lounge.email %> or call us at <%= format_phone_number(@special_offer.lounge.phone_number) %>.
        </p>
      </div>
      
      <div style="background-color: #333; color: #ccc; padding: 20px; text-align: center; font-size: 12px;">
        <p style="margin: 0;">Thank you for being a valued member!</p>
        <p style="margin: 5px 0 0 0;"><%= @special_offer.lounge.name %> Team</p>
        <p style="margin: 5px 0 0 0;">Powered by Herf</p>
      </div>
    </div>
  </body>
</html>