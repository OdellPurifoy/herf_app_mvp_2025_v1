<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RSVP Expired - <%= @rsvp&.event&.name || 'Event' %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
</head>

<body class="bg-gray-50 min-h-screen">
  <div class="max-w-2xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="bg-white shadow-lg rounded-lg overflow-hidden">
      <div class="bg-red-600 px-6 py-4">
        <h1 class="text-2xl font-bold text-white">RSVP Expired</h1>
      </div>

      <div class="px-6 py-8 text-center">
        <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-red-100 mb-6">
          <svg class="h-8 w-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>

        <h2 class="text-2xl font-bold text-gray-900 mb-4">This RSVP Link Has Expired</h2>
        
        <div class="bg-red-50 border border-red-200 rounded-lg p-6 mb-6">
          <p class="text-gray-700 mb-4">
            <%= @error_message || "The deadline for responding to this event invitation has passed." %>
          </p>
          
          <% if @rsvp&.event %>
            <div class="text-sm text-gray-600">
              <p class="font-medium">Event: <%= @rsvp.event.name %></p>
              <p>Date: <%= @rsvp.event.date.strftime("%A, %B %d, %Y") %></p>
              <p>RSVP Deadline: <%= @rsvp.expires_at.strftime("%B %d, %Y at %I:%M %p") %></p>
            </div>
          <% end %>
        </div>

        <div class="space-y-4">
          <p class="text-gray-600">
            If you need to update your RSVP or have questions about this event, 
            please contact the event organizer directly.
          </p>

          <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-sm text-gray-600">
              <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              RSVP links automatically expire 1 hour before the event start time to allow for proper planning.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
