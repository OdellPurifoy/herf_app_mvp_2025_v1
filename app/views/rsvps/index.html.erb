<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-semibold leading-6 text-gray-900">RSVP Management</h1>
      <p class="mt-2 text-sm text-gray-700">
        Manage RSVPs for "<%= @event.name %>" on <%= @event.date.strftime("%B %d, %Y") %>
      </p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
      <%= link_to 'Back to Dashboard', dashboard_path, 
          class: "block rounded-md bg-gray-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-gray-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-600" %>
    </div>
  </div>

  <!-- RSVP Summary Cards -->
  <% if @rsvp_summary %>
    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Attending -->
      <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Attending</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-green-600">
          <%= @rsvp_summary[:attending] %>
          <% if @rsvp_summary[:total_guests] > @rsvp_summary[:attending] %>
            <span class="text-lg text-gray-500">(<%= @rsvp_summary[:total_guests] %> guests)</span>
          <% end %>
        </dd>
      </div>

      <!-- Pending -->
      <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Pending Response</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-yellow-600"><%= @rsvp_summary[:pending] %></dd>
      </div>

      <!-- Declined -->
      <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Declined</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-red-600"><%= @rsvp_summary[:declined] %></dd>
      </div>

      <!-- Response Rate -->
      <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Response Rate</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-blue-600">
          <%= number_to_percentage(@event.rsvp_response_rate, precision: 1) %>
        </dd>
      </div>
    </div>

    <!-- Capacity Information -->
    <% if @event.capacity.present? %>
      <div class="mt-6 rounded-lg bg-gray-50 px-6 py-4">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-lg font-medium text-gray-900">Event Capacity</h3>
            <p class="text-sm text-gray-600">
              <%= @rsvp_summary[:total_guests] %> of <%= @event.capacity %> capacity confirmed
              <% if @rsvp_summary[:capacity_remaining] && @rsvp_summary[:capacity_remaining] > 0 %>
                (<%= @rsvp_summary[:capacity_remaining] %> spots remaining)
              <% else %>
                <span class="font-semibold text-red-600">(At Capacity!)</span>
              <% end %>
            </p>
          </div>
          <div class="text-right">
            <div class="text-2xl font-bold text-gray-900"><%= @rsvp_summary[:total_guests] %>/<%= @event.capacity %></div>
          </div>
        </div>
        <!-- Progress bar -->
        <div class="mt-3 w-full bg-gray-200 rounded-full h-2">
          <% percentage = (@rsvp_summary[:total_guests].to_f / @event.capacity * 100).round(1) %>
          <div class="bg-blue-600 h-2 rounded-full" style="width: <%= [percentage, 100].min %>%"></div>
        </div>
      </div>
    <% end %>
  <% end %>

  <!-- RSVP Table -->
  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">
                  Member
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">
                  Status
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">
                  Guest Count
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">
                  Contact
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">
                  Responded At
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @rsvps.each do |rsvp| %>
                <tr class="<%= 'bg-green-50' if rsvp.attending? %>">
                  <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
                    <%= rsvp.membership.member_name %>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900">
                    <span class="inline-flex rounded-full px-2 text-xs font-semibold leading-5 
                               <%= case rsvp.status
                                   when 'attending' then 'bg-green-100 text-green-800'
                                   when 'declined' then 'bg-red-100 text-red-800'
                                   when 'pending' then 'bg-yellow-100 text-yellow-800'
                                   when 'expired' then 'bg-gray-100 text-gray-800'
                                   else 'bg-gray-100 text-gray-800'
                                   end %>">
                      <%= rsvp.status_display %>
                    </span>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900">
                    <% if rsvp.attending? %>
                      <span class="font-semibold text-green-600"><%= rsvp.guest_count %></span>
                    <% else %>
                      <span class="text-gray-400">—</span>
                    <% end %>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                    <div><%= rsvp.membership.email %></div>
                    <% if rsvp.membership.phone_number.present? %>
                      <div class="text-xs text-gray-400"><%= rsvp.membership.phone_number %></div>
                    <% end %>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                    <% if rsvp.updated_at > rsvp.created_at %>
                      <%= time_ago_in_words(rsvp.updated_at) %> ago
                    <% else %>
                      <span class="text-gray-400">No response</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Summary footer -->
  <div class="mt-6 border-t border-gray-200 pt-6">
    <div class="flex justify-between text-sm text-gray-500">
      <span>Total RSVPs: <%= @rsvps.count %></span>
      <span>Last updated: <%= time_ago_in_words(@event.updated_at) %> ago</span>
    </div>
  </div>
</div>
