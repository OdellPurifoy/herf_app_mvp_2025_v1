<div class="bg-white">
  <!-- Hero -->
  <div class="relative isolate overflow-hidden bg-gray-900 pb-16 pt-14 sm:pb-20">
    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
      <div class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
    </div>
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl py-20 sm:py-28">
        <div class="text-center">
          <h1 class="text-balance text-4xl font-semibold text-white sm:text-6xl">Discover Cigar Events & Offers</h1>
          <p class="mt-6 text-pretty text-lg font-medium text-gray-300 sm:text-xl/8">
            Browse upcoming events and special offers from cigar lounges near you.
          </p>
        </div>
      </div>
    </div>
    <div class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]" aria-hidden="true">
      <div class="relative left-[calc(50%+3rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
    </div>
  </div>

  <main>
    <!-- Upcoming Events -->
    <section class="mx-auto max-w-7xl px-6 lg:px-8 mt-20 sm:mt-28">
      <div class="mx-auto max-w-2xl lg:text-center mb-12">
        <h2 class="text-base/7 font-semibold text-indigo-600">What's Coming Up</h2>
        <p class="mt-2 text-pretty text-4xl font-semibold tracking-tight text-gray-900 sm:text-balance sm:text-5xl">Upcoming Events</p>
      </div>

      <% if @events.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% @events.each do |event| %>
            <%= render "explore/event_card", event: event %>
          <% end %>
        </div>

        <div class="mt-10 flex justify-center">
          <%= paginate @events, param_name: :page %>
        </div>
      <% else %>
        <div class="text-center py-16 bg-gray-50 rounded-2xl">
          <svg class="mx-auto h-12 w-12 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
          </svg>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">No upcoming events</h3>
          <p class="mt-2 text-gray-500">Check back soon for new events from local lounges.</p>
        </div>
      <% end %>
    </section>

    <!-- Special Offers -->
    <section class="mx-auto max-w-7xl px-6 lg:px-8 mt-24 sm:mt-32">
      <div class="mx-auto max-w-2xl lg:text-center mb-12">
        <h2 class="text-base/7 font-semibold text-indigo-600">Don't Miss Out</h2>
        <p class="mt-2 text-pretty text-4xl font-semibold tracking-tight text-gray-900 sm:text-balance sm:text-5xl">Special Offers</p>
      </div>

      <% if @special_offers.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% @special_offers.each do |offer| %>
            <%= render "explore/offer_card", offer: offer %>
          <% end %>
        </div>

        <div class="mt-10 flex justify-center">
          <%= paginate @special_offers, param_name: :offers_page %>
        </div>
      <% else %>
        <div class="text-center py-16 bg-gray-50 rounded-2xl">
          <svg class="mx-auto h-12 w-12 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
          </svg>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">No special offers right now</h3>
          <p class="mt-2 text-gray-500">Check back soon for deals from local lounges.</p>
        </div>
      <% end %>
    </section>

    <!-- Featured Lounges -->
    <section class="mx-auto max-w-7xl px-6 lg:px-8 mt-24 sm:mt-32 pb-20 sm:pb-28">
      <div class="mx-auto max-w-2xl lg:text-center mb-12">
        <h2 class="text-base/7 font-semibold text-indigo-600">Find Your Spot</h2>
        <p class="mt-2 text-pretty text-4xl font-semibold tracking-tight text-gray-900 sm:text-balance sm:text-5xl">Featured Lounges</p>
      </div>

      <% if @lounges.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% @lounges.each do |lounge| %>
            <%= render "explore/lounge_card", lounge: lounge %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-16 bg-gray-50 rounded-2xl">
          <svg class="mx-auto h-12 w-12 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z" />
          </svg>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">No lounges listed yet</h3>
          <p class="mt-2 text-gray-500">Check back soon as lounges join the platform.</p>
        </div>
      <% end %>
    </section>

    <!-- CTA for lounge owners -->
    <section class="bg-gray-900">
      <div class="mx-auto max-w-7xl px-6 py-16 sm:py-24 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">Own a cigar lounge?</h2>
          <p class="mt-4 text-lg text-gray-300">List your lounge on HERF and reach new customers through your events and offers.</p>
          <div class="mt-8">
            <%= link_to "Learn More", root_path, class: "rounded-md bg-indigo-500 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500" %>          </div>
        </div>
      </div>
    </section>
  </main>
</div>
