<div class="bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/10 overflow-hidden">
  <% if offer.flyer.attached? %>
    <div class="aspect-video overflow-hidden">
      <%= image_tag offer.flyer.variant(resize_to_fill: [600, 340]),
                    class: "w-full h-full object-cover",
                    alt: offer.name %>
    </div>
  <% else %>
    <div class="aspect-video bg-gray-900 flex items-center justify-center">
      <svg class="h-10 w-10 text-gray-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
      </svg>
    </div>
  <% end %>

  <div class="p-5">
    <span class="inline-block px-2.5 py-0.5 text-xs font-medium bg-indigo-50 text-indigo-700 rounded-full mb-2">
      <%= offer.offer_type %>
    </span>

    <h3 class="text-lg font-semibold text-gray-900 mb-1"><%= offer.name %></h3>

    <p class="text-sm text-gray-600 mb-3">
      <%= offer.start_date.strftime("%b %-d") %> - <%= offer.end_date.strftime("%b %-d, %Y") %>
    </p>

    <% if offer.description.present? %>
      <p class="text-sm text-gray-500 line-clamp-2 mb-3"><%= offer.description %></p>
    <% end %>

    <div class="flex items-center gap-2 text-sm text-gray-500">
      <% if offer.lounge.logo.attached? %>
        <%= image_tag offer.lounge.logo.variant(resize_to_fill: [32, 32]),
                      class: "w-5 h-5 rounded-full object-cover",
                      alt: offer.lounge.name %>
      <% end %>
      <span><%= offer.lounge.name %></span>
    </div>

    <% if offer.members_only? %>
      <p class="mt-3 text-xs font-medium text-indigo-600">Members only</p>
    <% end %>
  </div>
</div>
