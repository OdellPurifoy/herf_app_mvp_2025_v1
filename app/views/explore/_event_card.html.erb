<%= link_to explore_event_path(event), class: "block group" do %>
  <div class="bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/10 overflow-hidden hover:shadow-md transition-shadow">
    <% if event.flyer.attached? %>
      <div class="aspect-video overflow-hidden">
        <%= image_tag event.flyer.variant(resize_to_fill: [600, 340]),
                      class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300",
                      alt: event.name %>
      </div>
    <% else %>
      <div class="aspect-video bg-gray-900 flex items-center justify-center">
        <svg class="h-10 w-10 text-gray-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
        </svg>
      </div>
    <% end %>

    <div class="p-5">
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-block px-2.5 py-0.5 text-xs font-medium bg-indigo-50 text-indigo-700 rounded-full">
          <%= event.event_type %>
        </span>
        <% if event.rsvp_needed? %>
          <span class="inline-block px-2.5 py-0.5 text-xs font-medium bg-gray-100 text-gray-600 rounded-full">
            RSVP Required
          </span>
        <% end %>
      </div>

      <h3 class="text-lg font-semibold text-gray-900 group-hover:text-indigo-600 transition-colors mb-1">
        <%= event.name %>
      </h3>

      <p class="text-sm text-gray-600 mb-3">
        <%= event.date.strftime("%A, %B %-d, %Y") %>
        &middot;
        <%= event.start_time.strftime("%-I:%M %p") %> - <%= event.end_time.strftime("%-I:%M %p") %>
      </p>

      <div class="flex items-center gap-2 text-sm text-gray-500">
        <% if event.lounge.logo.attached? %>
          <%= image_tag event.lounge.logo.variant(resize_to_fill: [32, 32]),
                        class: "w-5 h-5 rounded-full object-cover",
                        alt: event.lounge.name %>
        <% end %>
        <span><%= event.lounge.name %></span>
        <% if event.lounge.city.present? %>
          <span>&middot; <%= event.lounge.city %>, <%= event.lounge.state %></span>
        <% end %>
      </div>

      <% if event.entry_fee.present? && event.entry_fee.to_f > 0 %>
        <p class="mt-3 text-sm font-semibold text-gray-900">
          $<%= number_with_precision(event.entry_fee, precision: 2) %> entry
        </p>
      <% end %>
    </div>
  </div>
<% end %>
